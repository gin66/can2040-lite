; SPDX-License-Identifier: GPL-3.0-only
;
; CAN TX PIO program — one-shot per CAN message.
;
; Software, with the SM stopped:
;   * Y = number of message bits minus one. The message is SOF through the
;     one recessive bit that follows the CRC (MSB first, already stuffed).
;   * OSR holds the first on-wire word. The joined TX FIFO holds the rest.
;   * PC is at `reload`, so the first instruction arms the idle counter.
;
; Each bit drives the pin, then checks whether the message is finished.
; The bit after the CRC is only driven: no sample and no wait. The SM raises
; DONE and parks, and the pin stays at that recessive level (ACK, end of
; frame, interframe space). Earlier recessive bits are sampled; a dominant
; bus there is a conflict. Dominant bits are not sampled. No error flag.

.program can_tx
.wrap_target
idle_loop:
    jmp pin, saw_rec         ; 1  sample. Dominant falls into the reload.
reload:
    set x, 22                ; 1  23 samples. Wrap sends PC back to idle_loop.
.wrap
saw_rec:
    jmp !x, bitloop          ; 1  last sample: SOF on the next edge, no delay
    jmp x--, idle_loop [13]  ; 14 22 gaps of 1+1+14 = 16 cycles
bitloop:
    out x, 1                 ; 1  cycle 31 of the previous bit
    mov pins, x              ; 1  cycle 0, the edge
    jmp y--, more            ; 1  Y==0: bit after the CRC. Drive it and stop.
    irq set 6
    jmp park
more:
    jmp !x, dom [19]         ; 20 cycles 2..21. X==0: dominant, no sample.
    jmp pin, bitloop [8]     ; 9  cycle 22 sample, then cycles 23..30.
    irq set 7                ;    conflict falls through. Not part of the bit timing.
park:
    jmp park
dom:
    jmp bitloop [8]          ; 9  cycles 22..30
